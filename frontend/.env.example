# 복사해서 .env.local 로 쓰세요 (.env.local 은 커밋되지 않습니다)

# 이 파일은 설정 항목 안내용이라 비워 둔 채로 커밋합니다. 실제 값이 필요하면 .env.local 에 넣으세요.
# 아무것도 넣지 않아도 동작합니다: npm run dev 는 개발 서버 프록시로, 빌드(배포)는 https://api.todohama.site 로 부릅니다.

# 브라우저가 API 를 부를 주소를 바꾸고 싶을 때만 넣습니다.
VITE_API_URL=

# npm run dev 에서 /api 요청을 넘겨줄 백엔드. 비우면 https://api.todohama.site
# 로컬 백엔드를 띄웠다면 http://localhost:8080
VITE_API_PROXY_TARGET=
