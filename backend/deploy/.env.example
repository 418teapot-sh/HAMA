# 서버의 ~/hama/.env 로 복사해서 값을 채웁니다: cp .env.example .env && chmod 600 .env
# 이 파일에는 실제 값을 넣지 마세요. .env 는 .gitignore 로 막혀 있습니다.

# 랜덤 값으로 만드세요: openssl rand -base64 48
JWT_SECRET=

# RDS 엔드포인트. 앱은 hama 계정으로 접속하고, DB_PASSWORD 는 RDS 에 만든 hama 사용자의 비밀번호입니다.
DB_URL=jdbc:mysql://<RDS 엔드포인트>:3306/hama?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&sslMode=REQUIRED
DB_PASSWORD=

# 프론트 주소. 여러 개면 쉼표로 구분합니다.
CORS_ALLOWED_ORIGINS=https://www.todohama.site

LINER_API_KEY=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
