# 로컬 개발용. 복사해서 .env 로 쓰세요: cp .env.example .env
# JWT_SECRET 은 application-local.yml 에 더미가 있어서 로컬에선 불필요합니다.
LINER_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Paddle Sandbox 가격 ID(pri_...). 비워도 서버는 뜨지만 결제 웹훅이 UNKNOWN_PRICE 500 으로 크레딧이 안 들어갑니다.
PADDLE_PRICE_ID_1=
PADDLE_PRICE_ID_5=
PADDLE_PRICE_ID_12=
# 비워 두면 메일 대신 재설정 링크가 로그에 찍힙니다(local 프로필에서만).
RESEND_API_KEY=
# 로컬에 MySQL 이 따로 깔려 3306 을 쓰고 있으면 주석을 풀고 다른 포트로 바꾸세요.
# docker compose 와 Spring(bootRun·테스트, application.yml 의 config.import) 둘 다 이 파일을 읽습니다.
# 빈 값(DB_PORT=)으로 두면 Spring 쪽 기본값이 안 먹어서 DB 접속이 깨집니다.
# DB_PORT=3307
