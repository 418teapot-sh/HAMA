# 서버의 ~/hama/.env 로 복사해서 값을 채웁니다: cp .env.example .env && chmod 600 .env
# 이 파일에는 실제 값을 넣지 마세요. .env 는 .gitignore 로 막혀 있습니다.

# 랜덤 값으로 만드세요: openssl rand -base64 48
JWT_SECRET=

# MySQL 컨테이너가 처음 뜰 때 이 값으로 계정을 만듭니다. 이후에 바꾸려면 DB 에서도 바꿔야 합니다.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# 프론트 주소. 여러 개면 쉼표로 구분합니다.
CORS_ALLOWED_ORIGINS=https://www.todohama.site

LINER_API_KEY=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
