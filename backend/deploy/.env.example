# 서버 환경변수는 SSM Parameter Store 의 /hama/<키> 에 둡니다(서울 리전).
# ASG 서버가 부팅할 때(user-data.sh) 이 값들을 받아 /opt/hama/.env 를 만듭니다.
# 값을 바꾸려면 SSM 에서 고친 뒤 다시 배포합니다. 이 파일은 키 목록이고 실제 값을 넣지 않습니다.
# 비밀값(JWT_SECRET, DB_PASSWORD, LINER_API_KEY, PADDLE_WEBHOOK_SECRET, RESEND_API_KEY)은 SecureString 으로 넣습니다.
# SSM 은 빈 값을 못 넣어서, 아직 없는 키는 공백 한 칸으로 둡니다(앱이 공백을 빈 값으로 봄).

# 랜덤 값으로 만드세요: openssl rand -base64 48
JWT_SECRET=

# RDS 엔드포인트. 앱은 hama 계정으로 접속하고(DB_USERNAME 은 user-data.sh 가 넣음), DB_PASSWORD 는 RDS 에 만든 hama 사용자의 비밀번호입니다.
DB_URL=jdbc:mysql://<RDS 엔드포인트>:3306/hama?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&sslMode=REQUIRED
DB_PASSWORD=

# 프론트 주소. 여러 개면 쉼표로 구분합니다.
CORS_ALLOWED_ORIGINS=https://www.todohama.site

LINER_API_KEY=
PADDLE_WEBHOOK_SECRET=
# 크레딧 1·5·12회 상품의 가격 ID (pri_..., 상품 ID pro_... 아님)
PADDLE_PRICE_ID_1=
PADDLE_PRICE_ID_5=
PADDLE_PRICE_ID_12=

# 비밀번호 재설정·이메일 찾기 문의 메일(Resend SMTP, Sending access 키). 비어 있으면 메일이 나가지 않습니다(SecureString).
RESEND_API_KEY=
