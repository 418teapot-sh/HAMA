# 로컬 개발용. 복사해서 .env 로 쓰세요: cp .env.example .env
# JWT_SECRET 은 application-local.yml 에 더미가 있어서 로컬에선 불필요합니다.
LINER_API_KEY=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# 로컬에 MySQL 이 따로 깔려 3306 을 쓰고 있으면 다른 포트로. docker compose 는 .env 를 읽지만
# Spring(bootRun·테스트)은 안 읽으므로 OS 환경변수로도 넣어야 합니다: setx DB_PORT 3307
DB_PORT=
